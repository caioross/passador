<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Passador.Motor</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Passador.Core\Passador.Core.csproj" />
  </ItemGroup>
  <!-- O gancho nativo (native\gancho\gancho.c) é compilado com o MSVC antes do build e vai junto do programa. -->
  <Target Name="CompilarGancho" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\native\compilar.ps1&quot;" />
  </Target>
  <ItemGroup>
    <None Include="..\..\native\saida\passador_gancho.dll" Link="passador_gancho.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
