<Application x:Class="Batuta.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Palco escuro, o aparelho sob o refletor: o âmbar de luz de palco é a única cor de ação. -->
      <Color x:Key="CorPalco">#141118</Color>
      <Color x:Key="CorPalco2">#1A1620</Color>
      <Color x:Key="CorPainel">#201B27</Color>
      <Color x:Key="CorPainel2">#28222F</Color>
      <Color x:Key="CorTexto">#EEE9F3</Color>
      <Color x:Key="CorTexto2">#A9A1B5</Color>
      <Color x:Key="CorTexto3">#958EA1</Color>
      <Color x:Key="CorAmbar">#F4A940</Color>
      <Color x:Key="CorVioleta">#6C52BE</Color>
      <Color x:Key="CorInfo">#7FA9DA</Color>
      <Color x:Key="CorOk">#5CC98E</Color>
      <Color x:Key="CorErro">#E46A6A</Color>

      <SolidColorBrush x:Key="Palco" Color="{StaticResource CorPalco}"/>
      <SolidColorBrush x:Key="Palco2" Color="{StaticResource CorPalco2}"/>
      <SolidColorBrush x:Key="Painel" Color="{StaticResource CorPainel}"/>
      <SolidColorBrush x:Key="Painel2" Color="{StaticResource CorPainel2}"/>
      <SolidColorBrush x:Key="Borda" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="BordaForte" Color="#33FFFFFF"/>
      <SolidColorBrush x:Key="Texto" Color="{StaticResource CorTexto}"/>
      <SolidColorBrush x:Key="Texto2" Color="{StaticResource CorTexto2}"/>
      <SolidColorBrush x:Key="Texto3" Color="{StaticResource CorTexto3}"/>
      <SolidColorBrush x:Key="Ambar" Color="{StaticResource CorAmbar}"/>
      <SolidColorBrush x:Key="AmbarSuave" Color="#26F4A940"/>
      <SolidColorBrush x:Key="AmbarMedio" Color="#59F4A940"/>
      <SolidColorBrush x:Key="Info" Color="{StaticResource CorInfo}"/>
      <SolidColorBrush x:Key="Ok" Color="{StaticResource CorOk}"/>
      <SolidColorBrush x:Key="Erro" Color="{StaticResource CorErro}"/>
      <SolidColorBrush x:Key="Hover" Color="#12FFFFFF"/>

      <FontFamily x:Key="Display">pack://application:,,,/fontes/#Outfit</FontFamily>
      <FontFamily x:Key="Corpo">pack://application:,,,/fontes/#Lato</FontFamily>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      </Style>
      <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      </Style>
      <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      </Style>
      <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
      </Style>
      <Style x:Key="Explica" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
      </Style>

      <!-- Botões -->
      <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="{StaticResource Painel2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BordaForte}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ambar}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource Ambar}"/>
        <Setter Property="Foreground" Value="#1B1408"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
      </Style>
      <Style x:Key="BotaoFantasma" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="8,6"/>
      </Style>
      <Style x:Key="BotaoJanela" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Item do trilho lateral -->
      <Style x:Key="ItemTrilho" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Texto3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent" Height="66">
                <Border x:Name="barra" Width="3" HorizontalAlignment="Left" Margin="0,16" CornerRadius="2" Background="{StaticResource Ambar}" Opacity="0"/>
                <Border x:Name="fundo" Margin="12,4" CornerRadius="12" Background="Transparent"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <ContentPresenter HorizontalAlignment="Center"/>
                  <TextBlock x:Name="rot" Text="{TemplateBinding Tag}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"
                             Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="fundo" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="barra" Property="Opacity" Value="1"/>
                  <Setter Property="Foreground" Value="{StaticResource Ambar}"/>
                  <Setter TargetName="rot" Property="Foreground" Value="{StaticResource Texto}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="fundo" Property="Background" Value="{StaticResource Hover}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Ficha de escolha (perfis, modos) -->
      <Style x:Key="Ficha" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,5,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="b" CornerRadius="16" Padding="10,5" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource Borda}">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BordaForte}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ambar}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource AmbarSuave}"/>
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AmbarMedio}"/>
                  <Setter Property="Foreground" Value="{StaticResource Texto}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Interruptor -->
      <Style x:Key="Interruptor" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="trilho" Width="38" Height="22" CornerRadius="11" Background="#3A3442" VerticalAlignment="Center">
                  <Ellipse x:Name="bola" Width="16" Height="16" Fill="#D9D3E0" HorizontalAlignment="Left" Margin="3,0"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="trilho" Property="Background" Value="{StaticResource Ambar}"/>
                  <Setter TargetName="bola" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="bola" Property="Fill" Value="#FFF7EC"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="trilho" Property="Opacity" Value="0.85"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Campo de texto -->
      <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ambar}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Ambar}"/>
        <Setter Property="Background" Value="#16131B"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                <Grid>
                  <TextBlock x:Name="dica" Text="{TemplateBinding Tag}" Foreground="{StaticResource Texto3}" Margin="14,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                  <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter TargetName="dica" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="AcceptsReturn" Value="True">
                  <Setter Property="Height" Value="Auto"/>
                  <Setter Property="Padding" Value="10,8"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ambar}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Lista de escolha -->
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="b" Padding="12,8" CornerRadius="7" Background="Transparent" Margin="4,1">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AmbarSuave}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton x:Name="alternar" Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="b" Background="#16131B" BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="9">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L5,5 L10,0"
                              Stroke="{StaticResource Texto2}" StrokeThickness="1.6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BordaForte}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter IsHitTestVisible="False" Margin="12,8,32,8" VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <Border Background="#241F2C" BorderBrush="{StaticResource BordaForte}" BorderThickness="1" CornerRadius="10" Padding="0,4"
                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340" Margin="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="alternar" Property="Opacity" Value="0.95"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Régua (tempos) -->
      <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource Ambar}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Grid Height="24">
                <Border Height="4" CornerRadius="2" Background="#3A3442" VerticalAlignment="Center"/>
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                      <RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="{StaticResource Ambar}"/></ControlTemplate></RepeatButton.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                      <RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template><ControlTemplate><Ellipse Width="16" Height="16" Fill="{StaticResource Texto}"/></ControlTemplate></Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Barra de rolagem fina -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template><ControlTemplate><Border CornerRadius="4" Background="#33FFFFFF" Margin="2,0"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template><ControlTemplate><Border CornerRadius="4" Background="#33FFFFFF" Margin="0,2"/></ControlTemplate></Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#2A2432"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordaForte}"/>
        <Setter Property="FontFamily" Value="{StaticResource Corpo}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,6"/>
      </Style>

      <!-- Tecla desenhada (o que o botão manda) -->
      <Style x:Key="Tecla" TargetType="Border">
        <Setter Property="Background" Value="#2D2735"/>
        <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1,1,1,2.5"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
