<Window x:Class="Passador.App.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Passador.App"
        Title="Passador" Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        Background="{StaticResource Palco}" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/passador.ico" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Raiz" Background="{StaticResource Palco}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="92"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- Trilho -->
    <Border Background="#0F0D13" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Image DockPanel.Dock="Top" Source="pack://application:,,,/passador-256.png" Width="36" Height="36" Margin="0,20,0,26"
               RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Passador"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18" HorizontalAlignment="Center" Cursor="Hand" Background="Transparent"
                    x:Name="Motor" MouseLeftButtonUp="Motor_Clique">
          <Grid Width="14" Height="14" HorizontalAlignment="Center">
            <Ellipse x:Name="MotorHalo" Width="14" Height="14" Opacity="0.35"/>
            <Ellipse x:Name="MotorPonto" Width="7" Height="7"/>
          </Grid>
          <TextBlock x:Name="MotorTexto" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource Texto3}" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="Navegacao">
          <RadioButton x:Name="NavControle" Style="{StaticResource ItemTrilho}" Tag="Controle" GroupName="nav" IsChecked="True" Checked="Nav_Checked">
            <local:Icone Nome="controle" Width="22" Height="22"/>
          </RadioButton>
          <RadioButton x:Name="NavCatalogo" Style="{StaticResource ItemTrilho}" Tag="Catálogo" GroupName="nav" Checked="Nav_Checked">
            <local:Icone Nome="catalogo" Width="22" Height="22"/>
          </RadioButton>
          <RadioButton x:Name="NavPerfis" Style="{StaticResource ItemTrilho}" Tag="Perfis" GroupName="nav" Checked="Nav_Checked">
            <local:Icone Nome="perfis" Width="22" Height="22"/>
          </RadioButton>
          <RadioButton x:Name="NavAprender" Style="{StaticResource ItemTrilho}" Tag="Aprender" GroupName="nav" Checked="Nav_Checked">
            <local:Icone Nome="aprender" Width="22" Height="22"/>
          </RadioButton>
          <RadioButton x:Name="NavAjustes" Style="{StaticResource ItemTrilho}" Tag="Ajustes" GroupName="nav" Checked="Nav_Checked">
            <local:Icone Nome="ajustes" Width="22" Height="22"/>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Página -->
    <ContentControl x:Name="Pagina" Grid.Column="1" Focusable="False"/>

    <!-- Botões da janela -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button Style="{StaticResource BotaoJanela}" Click="Minimizar_Click" ToolTip="Minimizar">
        <local:Icone Nome="minimizar" Width="14" Height="14"/>
      </Button>
      <Button Style="{StaticResource BotaoJanela}" Click="Maximizar_Click" ToolTip="Maximizar">
        <local:Icone Nome="maximizar" Width="12" Height="12"/>
      </Button>
      <Button Style="{StaticResource BotaoJanela}" Click="Fechar_Click" ToolTip="Fechar (o Passador continua na bandeja)">
        <local:Icone Nome="fechar" Width="14" Height="14"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>
